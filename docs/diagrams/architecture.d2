direction: down

vars: {
  d2-config: {
    theme-id: 0
  }
}

classes: {
  box: {
    style: {
      fill: "#ffffff"
      stroke: "#334155"
      stroke-width: 2
      border-radius: 8
      font-size: 13
      font-color: "#0f172a"
    }
  }
  highlight: {
    style: {
      fill: "#f8fafc"
      stroke: "#0f172a"
      stroke-width: 2
      border-radius: 8
      font-size: 13
      font-color: "#0f172a"
      bold: true
    }
  }
  group: {
    style: {
      fill: "#ffffff"
      stroke: "#cbd5e1"
      stroke-width: 2
      border-radius: 10
      font-size: 14
      font-color: "#334155"
      bold: true
    }
  }
}

frontend: "Frontend Web (HTML / CSS / JS)" {
  class: group
  direction: right
  chat_ui: "Chat + Inspetor de Tools\nPerguntas, respostas e telemetria" { class: box }
  fleet_ui: "Painel da Frota\nKPIs e simulação de uso (− / +)" { class: box }
}

api: "Backend FastAPI (API REST)" {
  class: group
  direction: right
  chat_ep: "POST /api/chat" { class: box }
  fleet_ep: "GET · PATCH · POST\n/api/gpus" { class: box }
}

core: "Núcleo do Assistente" {
  class: group
  direction: right
  strategy: "ToolCallingStrategy\nLoop controlado (max_steps = 5)\n4 tools somente leitura:\nlist_gpus · find_gpus\ncheck_availability · get_fleet_summary" { class: highlight }
  llm_client: "OpenAICompatibleClient\nTelemetria (latência, tokens)\nNormalização multi-provider" { class: box }
  strategy -> llm_client: "Chat + JSON Schema"
}

data: "Camada de Dados (Repository Pattern)" {
  class: group
  direction: right
  repo: "GPURepository\nQueries determinísticas\nDesambiguação de nomes" { class: highlight }
  sqlite: "SQLite (gpus)\n5 GPUs do desafio\ntotal · disponíveis · VRAM" {
    shape: cylinder
    class: box
  }
  repo -> sqlite: "SQL parametrizado"
}

llm: "LLM (DeepSeek Flash)\nAPI OpenAI-Compatible" {
  class: box
}

frontend.chat_ui -> api.chat_ep: "HTTP / JSON"
frontend.fleet_ui -> api.fleet_ep: "HTTP / JSON"

api.chat_ep -> core.strategy: "chat(mensagem, histórico)"
api.fleet_ep -> data.repo: "leitura e escrita\n(simulação ao vivo)"

core.strategy -> data.repo: "somente leitura\n(menor privilégio)"
core.llm_client -> llm: "HTTPS / JSON"
