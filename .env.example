# Default database path
GPU_FLEET_DB_PATH=data/gpu_fleet.db

# Default provider: ollama | deepseek | mistral | custom
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# Local model via Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Mistral API (OpenAI-compatible)
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_KEY=

# Custom OpenAI-compatible provider (used when LLM_PROVIDER=custom)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
