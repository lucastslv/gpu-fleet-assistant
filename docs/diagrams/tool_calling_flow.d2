direction: down

vars: {
  d2-config: {
    theme-id: 0
  }
}

classes: {
  box: {
    style: {
      fill: "#ffffff"
      stroke: "#334155"
      stroke-width: 2
      border-radius: 8
      font-size: 14
      font-color: "#0f172a"
    }
  }
  core: {
    style: {
      fill: "#f8fafc"
      stroke: "#0f172a"
      stroke-width: 2
      border-radius: 8
      font-size: 14
      font-color: "#0f172a"
      bold: true
    }
  }
  invisible: {
    style: {
      fill: "transparent"
      stroke: "transparent"
    }
  }
}

entry: "" {
  class: invisible
  grid-rows: 1
  horizontal-gap: 180

  user: "Usuário\n(Web UI)" {
    shape: person
    style: {
      fill: "#f8fafc"
      stroke: "#334155"
      stroke-width: 2
      font-color: "#0f172a"
    }
  }

  api: "FastAPI\n(POST /api/chat)" {
    class: box
  }

  user <-> api: "Pergunta / Resposta"
}

loop: "Ciclo de Tool Calling" {
  direction: down
  style: {
    fill: "#ffffff"
    stroke: "#cbd5e1"
    stroke-width: 2
    border-radius: 10
    font-size: 13
    font-color: "#475569"
    bold: true
  }

  strategy: "ToolCallingStrategy\nLoop controlado (max_steps = 5)" {
    class: core
  }

  llm: "LLM\n(DeepSeek Flash)" {
    class: box
  }

  db: "GPURepository\n+ SQLite (gpus)" {
    shape: cylinder
    class: box
  }

  strategy -> llm: "Prompt / resultado"
  llm -> strategy: "tool_call / resposta"

  strategy -> db: "Consulta SQL (leitura)"
  db -> strategy: "Dados estruturados"
}

entry.api <-> loop.strategy: "Mensagem / Resposta + traces"
